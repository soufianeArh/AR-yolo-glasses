<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- gRPC to the Java scheduler -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 8.7: source "camera" (emulator: the PC webcam; glasses: their camera) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- usesCleartextTraffic: development backend without TLS (emulator -> 10.0.2.2:50051) -->
    <application
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

        <!-- 8.9: the entry screen (launcher) -->
        <activity
            android:name=".WelcomeActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DemoListActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- The inspection screen. Landscape, like the glasses display. Exported: tests start it
             directly with adb (launch extras) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 8.6: settings (long-press on the main screen, or the menu key) -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
